{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablefuturetech.com/ns/governance-compilation/v0.1.0/governed-action.schema.json",
  "title": "Governed Action",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action_id",
    "name",
    "description",
    "parameters",
    "targets",
    "permitted_action_status"
  ],
  "properties": {
    "action_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type",
          "bounded"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "bounded": {
            "type": "boolean"
          },
          "constraints": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "permitted_action_status": {
      "type": "string",
      "enum": [
        "in_set",
        "out_of_set",
        "conditional",
        "indeterminate"
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requirement_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
