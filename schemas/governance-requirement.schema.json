{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablefuturetech.com/ns/governance-compilation/v0.1.0/governance-requirement.schema.json",
  "title": "Governance Requirement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requirement_id",
    "statement",
    "normative_effect",
    "source_refs",
    "status"
  ],
  "properties": {
    "requirement_id": {
      "type": "string"
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "normative_effect": {
      "type": "string",
      "enum": [
        "obligation",
        "prohibition",
        "permission",
        "power",
        "constraint",
        "evidence",
        "invariant",
        "procedure",
        "other"
      ]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "interpretation_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "applies_to_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "applies_to_targets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "superseded",
        "withdrawn",
        "disputed",
        "indeterminate"
      ]
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
