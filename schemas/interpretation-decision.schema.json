{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablefuturetech.com/ns/governance-compilation/v0.1.0/interpretation-decision.schema.json",
  "title": "Interpretation Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "interpretation_id",
    "source_refs",
    "question",
    "decision",
    "authority_ref",
    "status"
  ],
  "properties": {
    "interpretation_id": {
      "type": "string"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "question": {
      "type": "string"
    },
    "decision": {
      "type": "string"
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority_ref": {
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "scope": {
      "type": "object"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dissent": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "effective_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "effective_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "approved",
        "disputed",
        "indeterminate",
        "superseded"
      ]
    }
  }
}
