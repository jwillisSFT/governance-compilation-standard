            "actions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "targets": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "domains": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
