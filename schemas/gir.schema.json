          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "action": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://sustainablefuturetech.com/ns/governance-compilation/v0.1.0/governed-action.schema.json",
