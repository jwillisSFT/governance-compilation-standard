      "properties": {
        "requirement_id": {
          "type": "string"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "normative_effect": {
          "type": "string",
          "enum": [
            "obligation",
            "prohibition",
            "permission",
            "power",
            "constraint",
            "evidence",
            "invariant",
            "procedure",
            "other"
          ]
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "interpretation_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "applies_to_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "applies_to_targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
