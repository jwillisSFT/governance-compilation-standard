          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "valid_until": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": [
            "current",
            "expired",
            "revoked",
            "superseded",
            "disputed",
            "unknown"
          ]
        },
        "revocation_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "requirement": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://sustainablefuturetech.com/ns/governance-compilation/v0.1.0/governance-requirement.schema.json",
      "title": "Governance Requirement",
