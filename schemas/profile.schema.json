{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablefuturetech.com/ns/governance-compilation/v0.1.0/profile.schema.json",
  "title": "Governance Compilation Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "version",
    "status",
    "spec_versions",
    "scope",
    "required_capabilities",
    "added_requirements"
  ],
  "properties": {
    "profile_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "normative",
        "draft",
        "experimental",
        "deprecated"
      ]
    },
    "spec_versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "string"
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "added_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mandatory_extensions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assurance_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runtime_dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "compatibility_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invalidation_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
