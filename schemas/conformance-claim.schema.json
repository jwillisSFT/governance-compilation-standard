{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablefuturetech.com/ns/governance-compilation/v0.1.0/conformance-claim.schema.json",
  "title": "Governance Compilation Conformance Claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "spec_version",
    "conformance_object",
    "subject",
    "profiles",
    "scope",
    "assurance_basis",
    "effective_period",
    "limitations",
    "exclusions",
    "invalidation_conditions"
  ],
  "properties": {
    "claim_id": {
      "type": "string"
    },
    "spec_version": {
      "type": "string"
    },
    "conformance_object": {
      "type": "string",
      "enum": [
        "process",
        "gir",
        "compiler",
        "compiler-qualification",
        "package",
        "validation",
        "repository",
        "activation",
        "runtime-consumer",
        "operating-protocol",
        "projection",
        "deployment-non-bypassability"
      ]
    },
    "subject": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "organization": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "object"
    },
    "automation_level": {
      "type": [
        "string",
        "null"
      ]
    },
    "assurance_basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "consequence_class": {
      "type": [
        "string",
        "null"
      ]
    },
    "assessment_body": {
      "type": [
        "string",
        "null"
      ]
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "effective_period": {
      "type": "object",
      "required": [
        "from"
      ],
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time"
        },
        "until": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved_findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "compensating_controls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invalidation_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "non_bypassability_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
